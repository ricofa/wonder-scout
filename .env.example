# WonderScout AI — environment template (TDD §11.2).
# Placeholders only. Copy to .env locally; never commit real values.

NODE_ENV=development

# Server-only (not used until later milestones)
DATABASE_URL=postgres://wonderscout:change-me@localhost:5432/wonderscout_dev
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Model — Devscale Gateway via @anvia/openai (chat API), selected in the Anvia compatibility spike
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gateway.devscale.id/v1
OPENAI_MODEL_ID=deepseek-v4.1-flash

# Embeddings — not yet selected (TDD §2.3 step 8)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Anvia Lens (optional local/external deployment)
ANVIA_LENS_BASE_URL=
ANVIA_LENS_PUBLIC_KEY=
ANVIA_LENS_SECRET_KEY=

ACTIVE_KB_VERSION=

# Data gates — keep false until Gate B / Gate C are passed (TDD §11.4)
ALLOW_REAL_DATA_SCORING=false
ALLOW_PUBLIC_DATA_DISPLAY=false
